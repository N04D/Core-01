[Unit]
Description=Social Engine Incremental RAG Indexer
After=local-fs.target

[Service]
Type=simple
User=@CORE_USER@
Group=@CORE_GROUP@
WorkingDirectory=@CORE_HOME@
Environment=PYTHONUNBUFFERED=1
Environment=PATH=@CORE_HOME@/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-@CORE_HOME@/.env
ExecStart=@CORE_HOME@/venv/bin/python3 @CORE_HOME@/daemon/rag_indexer.py --db @CORE_DATA@/db/events.db --root @CORE_HOME@/vault --interval 30
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
