[Unit]
Description=Social Engine Vault Folder Watchdog
After=network-online.target social-worker.service
Wants=network-online.target
Requires=social-worker.service

[Service]
Type=simple
User=infra
Group=infra
WorkingDirectory=/home/infra/dev
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/infra/dev/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/home/infra/dev/.env
ExecStart=/home/infra/dev/venv/bin/python3 /home/infra/dev/daemon/folder_watchdog.py --db /home/infra/dev/db/events.db --watch-directory /home/infra/dev/vault/uitgaand --archive-directory /home/infra/dev/vault/gepubliceerd
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
