[Unit]
Description=Social Engine Telegram inbound listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@CORE_USER@
Group=@CORE_GROUP@
WorkingDirectory=@CORE_HOME@
EnvironmentFile=-@CORE_HOME@/.env
ExecStart=@CORE_HOME@/venv/bin/python3 @CORE_HOME@/plugins/inputs/telegram_in.py --db @CORE_DATA@/db/events.db --auto-dispatch
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
