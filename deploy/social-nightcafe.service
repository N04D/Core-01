[Unit]
Description=NightCafe 99 Names Daily Stock Generator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=infra
Group=infra
WorkingDirectory=/home/infra/dev
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/infra/dev/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/home/infra/dev/.env
ExecStart=/home/infra/dev/venv/bin/python3 /home/infra/dev/playbooks/nightcafe_99names.py --db /home/infra/dev/db/events.db --live --claim-daily --headless
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
