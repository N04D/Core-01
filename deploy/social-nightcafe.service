[Unit]
Description=NightCafe 99 Names Daily Stock Generator
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@CORE_USER@
Group=@CORE_GROUP@
WorkingDirectory=@CORE_HOME@
Environment=PYTHONUNBUFFERED=1
Environment=PATH=@CORE_HOME@/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-@CORE_HOME@/.env
ExecStart=@CORE_HOME@/venv/bin/python3 @CORE_HOME@/playbooks/nightcafe_99names.py --db @CORE_DATA@/db/events.db --live --claim-daily --headless
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
